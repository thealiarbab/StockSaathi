# Secrets — NEVER commit.
# Glob covers .env.vercel / .env.production / anything future; the
# negation keeps the checked-in template visible.
.env*
!.env.example

# Logged emails — may contain personal data
logs/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.venv/
venv/
env/

# Node (if someone adds it later)
node_modules/
npm-debug.log*

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*~

# Build outputs
dist/
build/
*.log
.vercel

# Vendored pip output — `pip install --target .` leftovers. The api/*.py
# handlers are stdlib-only; nothing imports werkzeug.
werkzeug/
*.dist-info/
