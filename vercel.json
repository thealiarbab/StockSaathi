{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "echo 'no build step — static site + per-handler @vercel/python functions'",
  "installCommand": "echo 'no install step — api/*.py handlers use stdlib only'",
  "framework": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "regions": ["bom1"],
  "crons": [
    { "path": "/api/admin-sync-mf", "schedule": "45 15 * * *" },
    { "path": "/api/admin-sync-mf", "schedule": "30 17 * * *" },
    { "path": "/api/admin-sync-mf", "schedule": "30 20 * * *" },
    { "path": "/api/admin-sync-mf", "schedule": "45 1 * * *" },
    { "path": "/api/admin-sync-mf", "schedule": "40 3 * * 1-5" }
  ],
  "functions": {
    "api/*.py": { "runtime": "@vercel/python@6.36.0", "maxDuration": 60 }
  },
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.stocksaathi.co.in" }],
      "destination": "https://stocksaathi.co.in/$1",
      "permanent": true
    },
    { "source": "/market",  "destination": "/stocks", "permanent": true },
    { "source": "/markets", "destination": "/stocks", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/api/:path((?!ai$|chat$).*)",
      "destination": "/api/index?__path=:path"
    },
    {
      "source": "/js/data/:name(universeFull|mfFull).:hash([a-f0-9]{8}).json",
      "has": [{ "type": "header", "key": "accept-encoding", "value": ".*br.*" }],
      "destination": "/js/data/:name.:hash.json.br"
    },
    {
      "source": "/:route(login|register|reset-password-request|reset-password|onboarding|portfolio|orders|stocks|crash-replay|report-card|friends|news|chat|settings)",
      "destination": "/app-shell"
    },
    {
      "source": "/:route(stocks|crash-replay|a|share)/:param",
      "destination": "/app-shell"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type,X-StockSaathi-Relay" },
        { "key": "Access-Control-Max-Age", "value": "600" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/js/data/:name(universeFull|mfFull).:hash([a-f0-9]{8}).json.br",
      "headers": [
        { "key": "Content-Encoding", "value": "br" },
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Vary", "value": "Accept-Encoding" }
      ]
    },
    {
      "source": "/js/data/:name(universeFull|mfFull).:hash([a-f0-9]{8}).json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Vary", "value": "Accept-Encoding" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/handlers/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/vercel.json",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/.vercelignore",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/requirements.txt",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/js/data/:name(universeFull|mfFull).meta.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline' https:; font-src 'self' data: https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; frame-src 'self' https:; media-src 'self' data: blob: https:; connect-src 'self' https: wss:; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'" }
      ]
    }
  ]
}
