{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "echo 'no build step — static site + per-handler @vercel/python functions'",
  "installCommand": "echo 'no install step — api/*.py handlers use stdlib only'",
  "framework": null,
  "outputDirectory": ".",
  "functions": {
    "api/*.py": { "runtime": "@vercel/python@6.36.0", "maxDuration": 60 }
  },
  "rewrites": [
    {
      "source": "/js/data/:name(universeFull|mfFull).:hash([a-f0-9]{8}).json",
      "has": [{ "type": "header", "key": "accept-encoding", "value": ".*br.*" }],
      "destination": "/js/data/:name.:hash.json.br"
    },
    { "source": "/privacy",   "destination": "/privacy.html" },
    { "source": "/terms",     "destination": "/terms.html" },
    { "source": "/grievance", "destination": "/grievance.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type,X-StockSaathi-Relay" },
        { "key": "Access-Control-Max-Age", "value": "600" }
      ]
    },
    {
      "source": "/js/data/:name(universeFull|mfFull).:hash([a-f0-9]{8}).json.br",
      "headers": [
        { "key": "Content-Encoding", "value": "br" },
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Vary", "value": "Accept-Encoding" }
      ]
    },
    {
      "source": "/js/data/:name(universeFull|mfFull).:hash([a-f0-9]{8}).json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Vary", "value": "Accept-Encoding" }
      ]
    },
    {
      "source": "/js/data/:name(universeFull|mfFull).meta.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; script-src 'self' https://esm.sh; connect-src 'self' https: wss:; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'" }
      ]
    }
  ]
}
